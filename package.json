{
  "name": "ai-office",
  "version": "1.0.0",
  "private": true,
  "description": "AI Office rewrite: 3D office where AI agents work your GitHub issues (Node.js, SQLite, no Docker).",
  "type": "module",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "tsx watch apps/server/src/index.ts",
    "build": "tsc -p packages/shared/tsconfig.json && tsc -p packages/db/tsconfig.json && tsc -p apps/server/tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "db:seed": "node packages/db/cli/seed.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "yaml": "^2.0.0"
  }
}
